---
import { render } from 'astro:content';
import PostPage from '../../components/PostPage.astro';
import { getPosts, slugOf } from '../../lib/posts';
import { paths } from '../../i18n';

export async function getStaticPaths() {
  const posts = await getPosts('zh');
  return posts.map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}

const { post } = Astro.props;
const slug = slugOf(post);
const { Content } = await render(post);
// The two languages are separate: the language button goes to the other home page.
const alternates = { zh: paths.zh.post(slug) };
const switchHref = paths.en.home;
---
<PostPage lang="zh" post={post} Content={Content} switchHref={switchHref} alternates={alternates} />
