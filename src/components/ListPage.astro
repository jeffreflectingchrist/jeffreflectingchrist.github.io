---
import Base from '../layouts/Base.astro';
import PostEntry from './PostEntry.astro';
import Sidebar from './Sidebar.astro';
import { ui, paths, type Lang } from '../i18n';
import { getPosts, topicName, type Topic } from '../lib/posts';

interface Props {
  lang: Lang;
  // 'all' = the Articles page; a Topic = one category's page; nothing = home page.
  list?: 'all' | Topic;
}
const { lang, list } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const topic = list && list !== 'all' ? list : undefined;
const posts = await getPosts(lang, topic?.id);
const listTitle = topic ? topicName(topic, lang) : list === 'all' ? t.allArticles : undefined;
const here = (l: Lang) => (topic ? paths[l].topic(topic.id) : list === 'all' ? paths[l].articles : paths[l].home);
const otherHasIt = !topic || topic.show === 'both' || topic.show === other;
---
<Base
  lang={lang}
  title={listTitle}
  active={list ? 'articles' : ''}
  switchHref={otherHasIt ? here(other) : paths[other].articles}
  alternates={otherHasIt ? { zh: here('zh'), en: here('en') } : { [lang]: here(lang) }}
>
  <div class="layout pad">
    <main class="entries">
      {listTitle ? <h1 class="list-heading">{listTitle}</h1> : <h1 class="sr-only">{t.siteName}</h1>}
      {posts.length > 0
        ? posts.map((post) => <PostEntry post={post} lang={lang} />)
        : <p class="empty">{t.empty}</p>}
    </main>
    <Sidebar lang={lang} />
  </div>
</Base>
