---
import Base from '../layouts/Base.astro';
import PostEntry from './PostEntry.astro';
import Sidebar from './Sidebar.astro';
import { ui, paths, type Lang, type Category } from '../i18n';
import { getPosts } from '../lib/posts';

interface Props {
  lang: Lang;
  category?: Category;
}
const { lang, category } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const key = category === 'devotion' ? 'devotions' : category === 'article' ? 'articles' : 'home';
const posts = await getPosts(lang, category);
const heading = category ? t.nav[key as 'devotions' | 'articles'] : undefined;
const listTitle = category ? t.categories[category] : undefined;
---
<Base
  lang={lang}
  title={listTitle}
  active={category ? key : ''}
  switchHref={paths[other][key]}
  alternates={{ zh: paths.zh[key], en: paths.en[key] }}
>
  <div class="layout pad">
    <main class="entries">
      {listTitle ? <h1 class="list-heading">{listTitle}</h1> : <h1 class="sr-only">{t.siteName}</h1>}
      {posts.length > 0
        ? posts.map((post) => <PostEntry post={post} lang={lang} />)
        : <p class="empty">{t.empty}</p>}
    </main>
    <Sidebar lang={lang} />
  </div>
</Base>
