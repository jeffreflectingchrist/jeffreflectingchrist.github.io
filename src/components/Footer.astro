---
import { ui, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
---
<footer class="site-footer pad">
  <span>{t.copyright}</span>
  <a href={lang === 'zh' ? '/donate/' : '/en/donate/'}>{lang === 'zh' ? '奉献支持' : 'Support'}</a>
  <span class="footer-tag">{t.tagline}</span>
</footer>
