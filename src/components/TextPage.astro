---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { ui, paths, type Lang } from '../i18n';
import { SITE } from '../config';
import SubscribeForm from './SubscribeForm.astro';
import DonateSection from './DonateSection.astro';

interface Props {
  lang: Lang;
  kind: 'about' | 'subscribe';
}
const { lang, kind } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const editUrl = 'https://app.pagescms.org/jeffreflectingchrist/jeffreflectingchrist.github.io/main';
const editLabel = lang === 'zh' ? '✎ 编辑此页' : '✎ Edit this page';

let Content: any = null;
let heading = t.subscribeTitle;
if (kind === 'about') {
  const entry = await getEntry('pages', `${lang}/about`);
  if (entry) {
    Content = (await render(entry)).Content;
    heading = entry.data.title;
  } else {
    heading = t.menuAbout;
  }
}
---
<Base
  lang={lang}
  title={heading}
  active={kind}
  switchHref={paths[other][kind]}
  alternates={{ zh: paths.zh[kind], en: paths.en[kind] }}
>
  <div class="pad">
    <main class="post-wrap">
      <h1 class="h-title">{heading}</h1>
      {kind === 'about' && (
        <p class="owner-edit" id="owner-edit" hidden>
          <a href={editUrl} target="_blank" rel="noopener">{editLabel}</a>
        </p>
      )}
      {kind === 'about' ? (
        <div class="prose">{Content && <Content />}</div>
      ) : (
        <div class="prose">
          <p>{t.subscribeBlurb}</p>
          <SubscribeForm lang={lang} />
          {SITE.contactEmail && (
            <>
              <h2>{t.contactTitle}</h2>
              <p>{t.contactBlurb}</p>
              <p><a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
            </>
          )}
        </div>
      )}
      {kind === 'subscribe' && <DonateSection lang={lang} />}
    </main>
  </div>
</Base>
{kind === 'about' && (
  <script is:inline>
    (function () {
      try {
        var q = new URLSearchParams(location.search).get('edit');
        if (q === '1') localStorage.setItem('jrc-owner', '1');
        if (q === 'off') localStorage.removeItem('jrc-owner');
        if (localStorage.getItem('jrc-owner') === '1') {
          var el = document.getElementById('owner-edit');
          if (el) el.hidden = false;
        }
      } catch (e) {}
    })();
  </script>
)}
