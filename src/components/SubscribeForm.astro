---
import { ui, type Lang } from '../i18n';
import { SITE } from '../config';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
// Each language has its own Substack, so each subscribe box signs up to its own list.
const id = SITE.substack[lang];
const action = `https://${id}.substack.com/subscribe`;
---
{id ? (
  <form class="sub-form" action={action} method="get" target="_blank">
    <input type="email" name="email" required placeholder={t.emailPlaceholder} aria-label={t.emailPlaceholder} autocomplete="email" />
    <button class="btn" type="submit">{t.subscribeButton}</button>
  </form>
) : (
  <p>{t.subscribeSoon}</p>
)}
