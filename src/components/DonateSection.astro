---
import { type Lang } from '../i18n';

// Gifts go through /api/give (functions/api/give.js), which makes a Stripe checkout
// for the currency, amount and frequency the donor picks. The currency list and
// minimums must match CURRENCIES in functions/api/give.js.
const CURRENCIES = [
  { code: 'MYR', sym: 'RM', min: 10 },
  { code: 'SGD', sym: 'S$', min: 10 },
  { code: 'AUD', sym: 'A$', min: 10 },
];
const PORTAL = 'https://billing.stripe.com/p/login/4gM9AUf7bh0QbRw1QXd7q00';
const ADMIN_EMAIL = 'jeff.reflecting.christ@gmail.com';

const { lang, standalone = false } = Astro.props as { lang: Lang; standalone?: boolean };
const T = {
  zh: {
    title: '奉献支持',
    intro: [
      '辉映基督致力于免费开发和分享这些资源。你愿意的话，可以通过这里奉献，支持幕后需要的费用（网站或网络应用维护、软件需要、工具开发、硬件提升）。谢谢你的代祷与同行。',
      '定期奉献能帮助我们更好地计划，不过一次性的奉献也随时欢迎。',
    ],
    question: '你想如何支持？',
    freqs: { monthly: '每月', quarterly: '每季', yearly: '每年', oneoff: '一次', other: '其他方式' },
    currency: '货币', amount: '金额',
    min: '最低金额',
    cover: '多加 4%，帮我们承担 Stripe 的手续费',
    withFees: '（{base} + 手续费 {fee}）',
    every: { monthly: '每月', quarterly: '每三个月', yearly: '每年', oneoff: '一次' },
    otherPlaceholder: `想以其他方式支持（例如转账、服事上的配搭）？请在这里写下你的想法，我们会回复你。你也可以直接写信到 ${ADMIN_EMAIL}`,
    otherButton: '发送给管理员',
    otherSubject: '辉映基督：其他支持方式',
    button: '前往付款',
    loading: '正在前往 Stripe…',
    errAmount: '请输入金额（至少 {min}）。',
    errServer: '暂时无法前往付款，请稍后再试，或写信到 ' + ADMIN_EMAIL + '。',
    secure: '付款由 Stripe 安全处理，支持信用卡、借记卡及 Apple Pay。',
    taxNote: '这是个人奉献，不能扣税。',
    thanks: '谢谢你的奉献！确认邮件已寄到你的邮箱。',
    manageTitle: '管理付款',
    manageText: '如果你已经设置了定期支持，可以随时自行取消。',
    manageLink: '取消定期支持',
    manageChange: '如要更改金额、货币或频率，只需先取消原有的定期支持，再重新设置即可。',
  },
  en: {
    title: 'Support',
    intro: [
      'Jeff Reflecting Christ strives to freely develop and distribute these resources. If you would like to support the costs (webpage or webapp maintenance, software support, tools development, and hardware upgrade), you can give through this page. Thank you for your prayers and partnership.',
      'Regular giving helps our planning, though one-off gifts are always welcomed.',
    ],
    question: 'How would you like to give?',
    freqs: { monthly: 'Monthly', quarterly: 'Quarterly', yearly: 'Yearly', oneoff: 'One-off', other: 'Something else' },
    currency: 'Currency', amount: 'Amount',
    min: 'Minimum',
    cover: 'Add 4% to cover Stripe’s transaction costs',
    withFees: '({base} + {fee} for fees)',
    every: { monthly: 'every month', quarterly: 'every 3 months', yearly: 'every year', oneoff: 'once' },
    otherPlaceholder: `Would you like to support in another way (e.g. bank transfer, serving together)? Write your message here and we will get back to you. You can also email ${ADMIN_EMAIL}`,
    otherButton: 'Send to the admins',
    otherSubject: 'Jeff Reflecting Christ: another way to support',
    button: 'Continue to payment',
    loading: 'Opening Stripe…',
    errAmount: 'Please enter an amount (at least {min}).',
    errServer: 'Payment could not be opened just now. Please try again shortly, or email ' + ADMIN_EMAIL + '.',
    secure: 'Payments are handled securely by Stripe. Cards and Apple Pay accepted.',
    taxNote: 'Gifts are personal and not tax-deductible.',
    thanks: 'Thank you for your gift! A receipt is on its way to your inbox.',
    manageTitle: 'Manage payments',
    manageText: 'If you have already set up regular support, you can cancel it yourself at any time.',
    manageLink: 'Cancel regular support',
    manageChange: 'To change the amount, currency or frequency, simply cancel your current support and set up a new one.',
  },
}[lang];
const MAIL = { to: ADMIN_EMAIL, subject: T.otherSubject };
const CFG = { lang, CURRENCIES, T: { button: T.button, loading: T.loading, errAmount: T.errAmount, errServer: T.errServer, every: T.every, min: T.min, withFees: T.withFees }, FEE: 0.04 };
const FREQ_KEYS = ['monthly', 'quarterly', 'yearly', 'oneoff', 'other'] as const;
---
{!standalone && <hr class="ds-divider" />}
<section id="support">
  {standalone ? <h1 class="h-title">{T.title}</h1> : <h2 class="ds-title">{T.title}</h2>}
  <p class="give-thanks" id="give-thanks" hidden>{T.thanks}</p>
  <div class="prose">{T.intro.map((p) => <p>{p}</p>)}</div>

  <div class="give card">
    <h3>{T.question}</h3>
    <div class="give-choice" role="radiogroup" aria-label={T.question}>
      {FREQ_KEYS.map((k, i) => (
        <label><input type="radio" name="freq" value={k} checked={i === 0} /> <span>{T.freqs[k]}</span></label>
      ))}
    </div>

    <form class="give-pane" data-for="pay" id="give-form" novalidate>
      <div class="give-fields">
        <label class="give-field give-cur">
          <span>{T.currency}</span>
          <select id="give-currency">
            {CURRENCIES.map((c) => <option value={c.code}>{c.code}</option>)}
          </select>
        </label>
        <label class="give-field give-amt">
          <span>{T.amount}</span>
          <input id="give-amount" type="number" inputmode="decimal" min="0" step="0.01" placeholder="50" required />
        </label>
      </div>

      <label class="give-cover"><input type="checkbox" id="give-cover" /> <span>{T.cover}</span></label>
      <p class="give-summary" id="give-summary" aria-live="polite"></p>
      <p class="give-error" id="give-error" role="alert" hidden></p>
      <button type="submit" class="give-btn" id="give-btn">{T.button}</button>
      <p class="give-small">{T.secure}<br />{T.taxNote}</p>
    </form>

    <div class="give-pane" data-for="other" hidden>
      <textarea id="give-msg" rows="5" placeholder={T.otherPlaceholder}></textarea>
      <button type="button" class="give-btn" id="give-send">{T.otherButton}</button>
    </div>
  </div>

  <hr class="ds-divider" />
  <div class="prose">
    <h3>{T.manageTitle}</h3>
    <p>{T.manageText} <a href={PORTAL} target="_blank" rel="noopener">{T.manageLink}</a></p>
    <p>{T.manageChange}</p>
  </div>
</section>

<script is:inline define:vars={{ CFG, MAIL }}>
  (function () {
    var $ = function (id) { return document.getElementById(id); };
    var cur = $('give-currency'), amt = $('give-amount'), sum = $('give-summary'),
        err = $('give-error'), btn = $('give-btn'), cov = $('give-cover');
    var byCode = {}; CFG.CURRENCIES.forEach(function (c) { byCode[c.code] = c; });

    if (/[?&]thanks=1/.test(location.search)) $('give-thanks').hidden = false;

    // Start with the currency most likely to suit the visitor; they can change it.
    try {
      var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
      var guess = /Singapore/.test(tz) ? 'SGD' : /^Australia\//.test(tz) ? 'AUD' : 'MYR';
      cur.value = guess;
    } catch (e) {}

    function freq() { return document.querySelector('input[name="freq"]:checked').value; }
    function fmt(c, n) { return c.sym + ' ' + n.toLocaleString(undefined, { minimumFractionDigits: n % 1 ? 2 : 0, maximumFractionDigits: 2 }); }
    // Same sum as the server: whole cents, then 4% on top, rounded to the cent.
    function total(n) {
      var cents = Math.round(n * 100);
      return (cov.checked ? Math.round(cents * (1 + CFG.FEE)) : cents) / 100;
    }
    function update() {
      var c = byCode[cur.value], n = parseFloat(amt.value), f = freq();
      err.hidden = true;
      if (f === 'other') return;
      if (!(n > 0)) { sum.textContent = CFG.T.min + ': ' + fmt(c, c.min); return; }
      var t = total(n), extra = cov.checked
        ? ' ' + CFG.T.withFees.replace('{base}', fmt(c, n)).replace('{fee}', fmt(c, Math.round((t - n) * 100) / 100))
        : '';
      sum.textContent = fmt(c, t) + ' ' + CFG.T.every[f] + extra;
    }

    document.querySelectorAll('input[name="freq"]').forEach(function (r) {
      r.addEventListener('change', function () {
        var pane = r.value === 'other' ? 'other' : 'pay';
        document.querySelectorAll('.give-pane').forEach(function (n) { n.hidden = n.dataset.for !== pane; });
        update();
      });
    });
    cur.addEventListener('change', update);
    amt.addEventListener('input', update);
    cov.addEventListener('change', update);
    update();

    function fail(msg) { err.textContent = msg; err.hidden = false; btn.disabled = false; btn.textContent = CFG.T.button; }

    $('give-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var c = byCode[cur.value], n = parseFloat(amt.value);
      if (!(n >= c.min)) { fail(CFG.T.errAmount.replace('{min}', fmt(c, c.min))); amt.focus(); return; }
      btn.disabled = true; btn.textContent = CFG.T.loading; err.hidden = true;
      fetch('/api/give', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ currency: c.code, amount: n, cover: cov.checked, freq: freq(), lang: CFG.lang }),
      })
        .then(function (r) { return r.json().catch(function () { return {}; }); })
        .then(function (d) {
          if (d.url) { location.href = d.url; return; }
          if (d.error === 'amount') fail(CFG.T.errAmount.replace('{min}', fmt(c, c.min)));
          else fail(CFG.T.errServer);
        })
        .catch(function () { fail(CFG.T.errServer); });
    });

    // Restore the button if the visitor comes back from Stripe with the Back button.
    window.addEventListener('pageshow', function () { btn.disabled = false; btn.textContent = CFG.T.button; });

    $('give-send').addEventListener('click', function () {
      var msg = $('give-msg').value.trim();
      location.href = 'mailto:' + MAIL.to + '?subject=' + encodeURIComponent(MAIL.subject) +
        (msg ? '&body=' + encodeURIComponent(msg) : '');
    });
  })();
</script>

<style>
  .ds-divider { border: none; border-top: 1px solid currentColor; opacity: 0.2; margin: 2.5rem 0; }
  .ds-title { font-size: 1.6rem; margin: 0 0 1rem; }
  .give-thanks { padding: 14px 18px; border-radius: 12px; background: var(--card); border-left: 4px solid var(--sun); margin: 0 0 1.5rem; }
  .give { margin-top: 28px; padding: 28px 24px; border-radius: 18px; background: var(--card); text-align: center; }
  .give h3 { margin: 0 0 18px; font-size: 1.2rem; }
  .give-choice { display: inline-flex; flex-wrap: wrap; justify-content: center; border: 1px solid var(--ink); border-radius: 28px; padding: 4px; gap: 4px; font-family: var(--font-nav); max-width: 100%; }
  .give-choice label { cursor: pointer; }
  .give-choice input { position: absolute; opacity: 0; pointer-events: none; }
  .give-choice span { display: block; padding: 10px 18px; border-radius: 999px; white-space: nowrap; }
  .give-choice input:checked + span { background: var(--btn-bg); color: var(--btn-fg); }
  .give-choice input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .give-fields { display: flex; gap: 12px; justify-content: center; margin: 24px auto 0; max-width: 360px; text-align: left; }
  .give-field { display: flex; flex-direction: column; gap: 6px; font-family: var(--font-nav); font-size: 0.85rem; color: var(--muted); }
  .give-cur { flex: 0 0 110px; }
  .give-amt { flex: 1; }
  .give-field select, .give-field input { font: inherit; font-size: 1.1rem; color: var(--ink); background: transparent; border: 1px solid var(--ink); border-radius: 12px; padding: 12px 14px; width: 100%; box-sizing: border-box; min-width: 0; }
  .give-field select:focus-visible, .give-field input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .give-field select option { color: #000; }
  .give-cover { display: inline-flex; align-items: center; gap: 8px; margin: 18px auto 0; cursor: pointer; font-size: 0.95rem; text-align: left; max-width: 360px; }
  .give-cover input { width: 18px; height: 18px; accent-color: var(--sun); flex: none; margin: 0; }
  .give-summary { color: var(--muted); margin: 14px 0 18px; min-height: 1.5em; }
  .give-error { color: var(--accent); font-weight: 600; margin: -6px 0 16px; }
  .give-btn { display: inline-block; background: var(--sun); color: #fff; padding: 14px 30px; border: none; border-radius: 999px; text-decoration: none; font-family: var(--font-nav); font-weight: 600; font-size: 1rem; cursor: pointer; }
  .give-btn:hover { color: #fff; filter: brightness(1.08); }
  .give-btn:disabled { opacity: 0.7; cursor: progress; }
  .give-small { margin-top: 18px; font-size: 0.85rem; color: var(--muted); }
  #give-msg { display: block; width: 100%; box-sizing: border-box; margin: 18px 0; padding: 12px 14px; border: 1px solid var(--ink); border-radius: 12px; background: transparent; color: inherit; font: inherit; resize: vertical; }
  @media (max-width: 480px) { .give-choice span { padding: 8px 12px; } .give { padding: 24px 16px; } }
</style>
