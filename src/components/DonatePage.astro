---
import Base from '../layouts/Base.astro';
import DonateSection from './DonateSection.astro';
import { type Lang } from '../i18n';

// Same content as the SUBSCRIBE page's support section (edit DonateSection.astro).
const { lang } = Astro.props as { lang: Lang };
const title = lang === 'zh' ? '奉献支持' : 'Support';
const there = lang === 'zh' ? '/en/donate/' : '/donate/';
---
<Base lang={lang} title={title} active="donate" switchHref={there}
  alternates={{ zh: '/donate/', en: '/en/donate/' }}>
  <div class="pad">
    <main class="post-wrap">
      <DonateSection lang={lang} standalone />
    </main>
  </div>
</Base>
