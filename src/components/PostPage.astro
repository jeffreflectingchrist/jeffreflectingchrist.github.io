---
import Base from '../layouts/Base.astro';
import Illustration from './Illustration.astro';
import { ui, paths, formatDate, type Lang } from '../i18n';
import { readMinutes, topicName, type Post } from '../lib/posts';

interface Props {
  lang: Lang;
  post: Post;
  Content: any;
  switchHref: string;
  alternates: { zh?: string; en?: string };
}
const { lang, post, Content, switchHref, alternates } = Astro.props;
const t = ui[lang];
const cover = post.cover;
const back = post.topic ? paths[lang].topic(post.topic.id) : paths[lang].articles;
const mins = readMinutes(post.body ?? '', lang);
---
<Base
  lang={lang}
  title={post.title}
  description={post.summary}
  active="articles"
  switchHref={switchHref}
  alternates={alternates}
  ogType="article"
>
  <div class="pad">
    <article class="post-wrap">
      <h1 class="h-title">{post.title}</h1>
      <div class="meta">
        <span class="pill">{formatDate(post.date, lang)}</span>
        {post.topic ? <a class="chip" href={back}>{topicName(post.topic, lang)}</a> : <span class="chip">{t.article}</span>}
        <span class="readtime">{t.readTime(mins)}</span>
      </div>
      {cover && (
        <div class="cover">
          {cover === 'illustration' ? <Illustration /> : <img src={cover} alt="" />}
        </div>
      )}
      <div class="prose"><Content /></div>
      <a class="read-more" href={back}>{post.topic ? `← ${topicName(post.topic, lang)}` : t.backTo}</a>
    </article>
  </div>
</Base>
