---
import Base from '../layouts/Base.astro';
import Illustration from './Illustration.astro';
import { ui, paths, formatDate, type Lang } from '../i18n';
import { readMinutes, type Post } from '../lib/posts';

interface Props {
  lang: Lang;
  post: Post;
  Content: any;
  switchHref: string;
  alternates: { zh?: string; en?: string };
}
const { lang, post, Content, switchHref, alternates } = Astro.props;
const t = ui[lang];
const cat = post.data.category;
const listKey = cat === 'devotion' ? 'devotions' : 'articles';
const cover = post.data.cover;
const mins = readMinutes(post.body ?? '', lang);
---
<Base
  lang={lang}
  title={post.data.title}
  description={post.data.summary}
  active={listKey}
  switchHref={switchHref}
  alternates={alternates}
  ogType="article"
>
  <div class="pad">
    <article class="post-wrap">
      <h1 class="h-title">{post.data.title}</h1>
      <div class="meta">
        <span class="pill">{formatDate(post.data.date, lang)}</span>
        <span class="chip">{t.categories[cat]}</span>
        <span class="readtime">{t.readTime(mins)}</span>
      </div>
      {cover && (
        <div class="cover">
          {cover === 'illustration' ? <Illustration /> : <img src={cover} alt="" />}
        </div>
      )}
      <div class="prose"><Content /></div>
      <a class="read-more" href={paths[lang][listKey]}>{t.backTo[cat]}</a>
    </article>
  </div>
</Base>
