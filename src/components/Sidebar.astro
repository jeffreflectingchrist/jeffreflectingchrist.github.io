---
import { ui, paths, type Lang } from '../i18n';
import SubscribeForm from './SubscribeForm.astro';
import { getPosts, slugOf } from '../lib/posts';

const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const p = paths[lang];
const latest = (await getPosts(lang, 'devotion')).slice(0, 3);
---
<aside class="aside">
  <div class="welcome">
    <p>{t.welcome}</p>
    <span class="signature">— {t.author}</span>
    <svg viewBox="0 0 260 14" aria-hidden="true"><path d="M3 8 C28 2 46 13 72 7 S120 2 148 8 S206 12 257 5" fill="none" stroke="var(--sun)" stroke-width="3" stroke-linecap="round"/></svg>
  </div>

  <div class="card">
    <h2>{t.subscribeTitle}</h2>
    <p>{t.subscribeBlurb}</p>
    <SubscribeForm lang={lang} />
  </div>

  <div class="card">
    <h2>{lang === 'zh' ? '奉献支持' : 'Support'}</h2>
    <p>{lang === 'zh' ? '若这些资源对你有帮助，欢迎支持我们以便帮助更多人。' : 'If these resources have helped you, you can support it here to help them reach more people.'}</p>
    <a class="donate-link" href={lang === 'zh' ? '/donate/' : '/en/donate/'}>{lang === 'zh' ? '奉献 →' : 'Give →'}</a>
  </div>

  {latest.length > 0 && (
    <div class="card latest">
      <span class="card-label">{t.latest}</span>
      {latest.map((post) => <a href={p.post(slugOf(post))}>{post.data.title}</a>)}
    </div>
  )}
</aside>

<style>
  .donate-link { display:inline-block; margin-top:6px; background: var(--sun); color:#fff; padding:9px 20px; border-radius:999px; text-decoration:none; font-family: var(--font-nav); }
  .donate-link:hover { color:#fff; filter:brightness(1.08); }
</style>
