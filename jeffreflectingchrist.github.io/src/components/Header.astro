---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { ui, paths, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  active?: string;
  switchHref: string;
}
const { lang, active = '', switchHref } = Astro.props;
const t = ui[lang];
const p = paths[lang];
const items = [
  { key: 'devotions', label: t.nav.devotions, href: p.devotions },
  { key: 'articles', label: t.nav.articles, href: p.articles },
  { key: 'about', label: t.nav.about, href: p.about },
  { key: 'subscribe', label: t.nav.subscribe, href: p.subscribe },
];
---
<header class="site-header pad">
  <a class="brand" href={p.home} aria-label={t.siteName}>
    <Logo />
    {lang === 'zh'
      ? <span class="brand-text"><span class="brand-a">辉映</span>基督</span>
      : <span class="brand-text"><span class="brand-a">jeff</span>reflectingchrist</span>}
  </a>

  <nav class="nav-full" aria-label={t.navLabel}>
    {items.map((i) => (
      <a class:list={['nav-link', { active: active === i.key }]} href={i.href} aria-current={active === i.key ? 'page' : undefined}><span>{i.label}</span></a>
    ))}
    <a class="lang-switch" href={switchHref} hreflang={t.otherHtmlLang} lang={t.otherHtmlLang}>{t.switchLabel}</a>
    <ThemeToggle lang={lang} />
  </nav>

  <div class="header-mobile">
    <ThemeToggle lang={lang} />
    <details class="nav-menu">
      <summary aria-label={t.menu}>
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
          <circle cx="6" cy="8" r="2" fill="currentColor"/><circle cx="12" cy="8" r="2" fill="currentColor"/><circle cx="18" cy="8" r="2" fill="currentColor"/>
          <circle cx="6" cy="16" r="2" fill="currentColor"/><circle cx="12" cy="16" r="2" fill="currentColor"/><circle cx="18" cy="16" r="2" fill="currentColor"/>
        </svg>
      </summary>
      <div class="menu-panel">
        {items.map((i) => <a href={i.href}>{i.label}</a>)}
        <a class="menu-lang" href={switchHref} hreflang={t.otherHtmlLang} lang={t.otherHtmlLang}>{t.switchLabel}</a>
      </div>
    </details>
  </div>
</header>

<script is:inline>
  document.querySelectorAll('.theme-toggle').forEach(function (b) {
    b.addEventListener('click', function () {
      var r = document.documentElement;
      var n = r.dataset.theme === 'dark' ? 'light' : 'dark';
      r.dataset.theme = n;
      try { localStorage.setItem('theme', n); } catch (e) {}
    });
  });
</script>
